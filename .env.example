# NumberShield - Environment Configuration Template (.env.example)
# No database configuration needed — data runs entirely in-memory.

# --- Optional: Gmail Discovery (read-only OAuth) ---
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/discovery/gmail/callback

# --- Optional: Public Web Search (Google Programmable Search) ---
GOOGLE_CSE_API_KEY=your-google-cse-api-key
GOOGLE_CSE_CX=your-google-cse-cx

# --- Optional: Breach Check (Have I Been Pwned paid key) ---
HIBP_API_KEY=your-hibp-api-key