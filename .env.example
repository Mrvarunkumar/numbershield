# NumberShield 2.0 - Environment Configuration Template (.env.example)
# Zero permanent database: all data is ephemeral and self-destructs automatically.

# --- Environment Mode (development | production) ---
ENVIRONMENT=development

# --- Admin API Key for Security Dashboard ---
ADMIN_API_KEY=numbershield-admin-key-2026

# --- Passwordless Email OTP (Gmail SMTP or Transactional Provider) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-google-app-password
SMTP_FROM=your-email@gmail.com

# --- Real-World Email Source Scanner (IMAP SSL, Optional - defaults to SMTP credentials) ---
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your-email@gmail.com
IMAP_PASS=your-google-app-password

# --- Google Sign-In (OpenID Connect Authentication ONLY - No Mailbox Access) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback

# --- Public Web Search (Google Programmable Search) ---
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# --- Public Breach Check (Have I Been Pwned paid key, optional) ---
HIBP_API_KEY=

# --- Ephemeral Data Lifetimes (Seconds) ---
OTP_TTL_SECONDS=300
SESSION_TTL_SECONDS=1800
SCAN_TTL_SECONDS=900
